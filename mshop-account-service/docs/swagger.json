{
    "swagger": "2.0",
    "info": {
        "description": "API documentation for the account service",
        "title": "Account Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/login": {
            "post": {
                "description": "Receives username and password, returns a success message if payload is valid",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "parameters": [
                    {
                        "description": "User login credentials",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/register": {
            "post": {
                "description": "Receives user and organization registration data together and returns confirmation message",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Registration"
                ],
                "parameters": [
                    {
                        "description": "Combined registration payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "test123"
                },
                "username": {
                    "type": "string",
                    "example": "ivan.ivic"
                }
            }
        },
        "models.OrganizationRegisterRequest": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string",
                    "example": "Savska cesta 123, Zagreb"
                },
                "email": {
                    "type": "string",
                    "example": "info@mshop.hr"
                },
                "name": {
                    "type": "string",
                    "example": "mShop d.o.o."
                },
                "oib": {
                    "type": "string",
                    "example": "12345678901"
                },
                "phone_number": {
                    "type": "string",
                    "example": "+38515555555"
                }
            }
        },
        "models.RegistrationRequest": {
            "type": "object",
            "properties": {
                "organization": {
                    "$ref": "#/definitions/models.OrganizationRegisterRequest"
                },
                "user": {
                    "$ref": "#/definitions/models.UserRegisterRequest"
                }
            }
        },
        "models.UserRegisterRequest": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string",
                    "example": "Savska cesta 14, Zagreb"
                },
                "date_of_birth": {
                    "type": "string",
                    "example": "1990-05-20"
                },
                "email": {
                    "type": "string",
                    "example": "ivan@example.com"
                },
                "first_name": {
                    "type": "string",
                    "example": "Ivan"
                },
                "is_admin": {
                    "type": "boolean",
                    "example": true
                },
                "last_name": {
                    "type": "string",
                    "example": "Ivić"
                },
                "phone_number": {
                    "type": "string",
                    "example": "+38599111222"
                },
                "username": {
                    "type": "string",
                    "example": "ivan.ivic"
                }
            }
        }
    }
}